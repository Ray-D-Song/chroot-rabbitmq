#!/usr/bin/env bash
set -euo pipefail

ROOTFS=''
DATA_DIR=''
CONF_DIR=''
LOG_DIR=''

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rootfs|--data-dir|--conf-dir|--log-dir)
      key="$1"; shift; [[ $# -gt 0 ]] || { echo "missing value for $key" >&2; exit 2; }
      case "$key" in
        --rootfs) ROOTFS="$1" ;;
        --data-dir) DATA_DIR="$1" ;;
        --conf-dir) CONF_DIR="$1" ;;
        --log-dir) LOG_DIR="$1" ;;
      esac
      shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

[[ $EUID -eq 0 ]] || { echo 'chroot-rabbitmq-run must be run by root' >&2; exit 1; }
[[ -d "$ROOTFS" && -d "$DATA_DIR" && -d "$CONF_DIR" && -d "$LOG_DIR" ]] \
  || { echo 'rootfs, data, configuration, or log directory does not exist' >&2; exit 1; }
[[ -f "$CONF_DIR/rabbitmq.conf" ]] || { echo "missing configuration file: $CONF_DIR/rabbitmq.conf" >&2; exit 1; }
[[ -f "$CONF_DIR/rabbitmq-env.conf" ]] || { echo "missing environment file: $CONF_DIR/rabbitmq-env.conf" >&2; exit 1; }

mkdir -p "$ROOTFS/var/lib/rabbitmq" "$ROOTFS/etc/rabbitmq" "$ROOTFS/var/log/rabbitmq"
mount --bind "$DATA_DIR" "$ROOTFS/var/lib/rabbitmq"
mount --bind "$CONF_DIR" "$ROOTFS/etc/rabbitmq"
mount --bind "$LOG_DIR" "$ROOTFS/var/log/rabbitmq"

exec chroot "$ROOTFS" env HOME=/var/lib/rabbitmq LANG=C LC_ALL=C /usr/sbin/rabbitmq-server
